<!DOCTYPE html>
<html lang="sk" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Čistenie ulice</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" asp-append-version="true">
</head>
<body class="po-bg d-flex flex-column min-vh-100">
    <header class="po-header border-bottom">
        <div class="container">
            <div class="row align-items-center py-3 text-center text-md-start">

                <div class="col-12 col-md-3 mb-2 mb-md-0 d-flex justify-content-center justify-content-md-start"></div>

                <div class="col-12 col-md-6 text-center text-md-center">
                    <h1 class="po-title m-0">ČISTENIE ULICE</h1>
                </div>

                <div class="col-12 col-md-3 d-none d-md-block"></div>
            </div>
        </div>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="container my-3">
            @RenderBody()
        </div>
    </main>

    <footer class="po-footer text-white mt-4">
        <div class="container small py-4 text-center text-md-start">
            
            <div>
                <small class="text-muted">Verzia: @AppVersion.GetCurrentVersion()</small>

                <p>
                    © @DateTime.Today.Year
                </p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
